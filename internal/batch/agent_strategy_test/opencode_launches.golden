== builtin-reuse-missing-session-fallback
command[0]: export TEST_ENV=test-value; opencode run --format json --session 'ses-old' "$(cat .sandman/task.md)"
command[1]: export TEST_ENV=test-value; opencode run --format json --continue "$(cat .sandman/task.md)"
status: success
usage_limit_reached: false
context_exhausted: false
session.json: {
  "protocol": "opencode-session/v1",
  "provider": "opencode",
  "session_id": "ses-fallback"
}
run.log: [run-1] HH:MM:SS Error: Session not found
run.log: [run-1] HH:MM:SS resumed
